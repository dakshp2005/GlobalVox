// Prisma schema for the GlobalVox RSVP calling campaign manager.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CampaignStatus {
  DRAFT
  RUNNING
  COMPLETED
}

enum InviteeStatus {
  PENDING       // imported, not yet called
  IN_PROGRESS   // a call is currently being attempted
  CONFIRMED     // will attend
  DECLINED      // will not attend
  UNDECIDED     // unsure / decide later
  CALLBACK      // asked to be called back later; see Invitee.callbackAt
  FAILED        // exhausted retries without a usable answer (no-answer, busy, provider error)
  INVALID       // failed import validation (bad phone/email) - never called
}

enum CallOutcome {
  CONFIRMED
  DECLINED
  UNDECIDED
  CALLBACK_REQUESTED
  NO_ANSWER
  PROVIDER_ERROR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("users")
}

model Campaign {
  id            String         @id @default(cuid())
  eventName     String
  eventDate     DateTime
  eventLocation String
  campaignName  String
  // Optional details the voice agent can answer callers' questions with.
  eventTime     String?        // e.g. "6:30 PM onwards"
  venueDetails  String?        // address / landmark / directions
  faqNotes      String?        // one "Topic: answer" per line, e.g. "Parking: free at the venue"
  // Voice agent settings, editable from the campaign form. Null = use the built-in default.
  agentPrompt   String?        // the agent's instructions (persona, tone, what to ask)
  agentVoice    String?        // "female" | "male": voice preference and Hindi/Gujarati verb forms
  status        CampaignStatus @default(DRAFT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  invitees Invitee[]

  @@map("campaigns")
}

model Invitee {
  id            String        @id @default(cuid())
  campaignId    String
  campaign      Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  externalId    String?       // id from the imported CSV, if provided
  name          String
  phone         String
  email         String?
  status        InviteeStatus @default(PENDING)
  attemptCount  Int           @default(0)
  invalidReason String?       // set when status = INVALID
  callbackAt    DateTime?     // set when status = CALLBACK: when the invitee asked to be called
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  callAttempts CallAttempt[]

  @@index([campaignId, status])
  @@map("invitees")
}

model CallAttempt {
  id              String       @id @default(cuid())
  inviteeId       String
  invitee         Invitee      @relation(fields: [inviteeId], references: [id], onDelete: Cascade)
  attemptNumber   Int
  startedAt       DateTime     @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  outcome         CallOutcome?
  errorMessage    String?
  transcript      Json?        // [{ role: "agent" | "user", content }] for AI voice calls
  summary         String?      // short AI-written summary of the call
  callbackAt      DateTime?    // callback time the invitee asked for on this call

  @@index([inviteeId])
  @@map("call_attempts")
}
